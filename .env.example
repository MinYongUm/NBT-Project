# NBT-Project - .env.example
# 실제 사용 시 이 파일을 .env로 복사 후 수정하세요.
# .env 파일은 .gitignore에 의해 Git 추적에서 제외됩니다.

# =================================================================
# 필수: 장비 접속 계정
# =================================================================
NBT_USERNAME=your_username
NBT_PASSWORD=your_password

# =================================================================
# 백업 저장 경로 (Docker 환경: docker-compose.yml에서 설정)
# =================================================================
NBT_BACKUP_ROOT=/data/backup

# =================================================================
# 타임존
# =================================================================
TZ=Asia/Seoul

# =================================================================
# Slack 알림 (선택)
# settings.yaml의 notify.slack.webhook_url보다 우선 적용됩니다.
# Slack Workspace → Apps → Incoming Webhooks에서 URL 발급
# =================================================================
# NBT_SLACK_WEBHOOK=https://hooks.slack.com/services/XXX/YYY/ZZZ

# =================================================================
# Email 알림 (선택)
# settings.yaml의 notify.email.smtp_user/smtp_password보다 우선 적용됩니다.
# Gmail 사용 시: Google 계정 → 보안 → 앱 비밀번호 발급 후 사용
# =================================================================
# NBT_SMTP_USER=your_email@gmail.com
# NBT_SMTP_PASSWORD=your_app_password