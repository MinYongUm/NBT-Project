# NBT-Project 환경변수 템플릿
# 실제 사용 시 이 파일을 .env로 복사 후 값을 채우세요.
# .env 파일은 절대 Git에 push하지 마세요.
#
# 적용 방법:
#   cp .env.example .env
#   chmod 600 .env

# 장비 접속 계정 (필수)
# 계정 정보는 반드시 이 파일에서만 관리합니다.
# settings.yaml에 계정 정보를 작성하지 마세요.
NBT_USERNAME=your_username
NBT_PASSWORD=your_password

# 백업 저장 경로 (필수)
# Docker 환경: 컨테이너 내부 경로 (볼륨 마운트 기준)
NBT_BACKUP_ROOT=/data/backup

# 타임존 (선택, 기본값: Asia/Seoul)
TZ=Asia/Seoul