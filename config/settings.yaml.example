# NBT-Project 설정 파일 템플릿
# 실제 사용 시 이 파일을 config/settings.yaml 로 복사 후 수정하세요.
# 계정 정보(username, password)는 이 파일에 작성하지 마세요. → .env 파일에서 관리

# =================================================================
# 장비 목록
# =================================================================
devices:
  mgmt:
    device_type: cisco_ios
    hosts:
      - 192.168.0.210
      - 192.168.0.211

  nexus:
    device_type: cisco_nxos
    hosts:
      - 192.168.0.212
      - 192.168.0.213

  aci:
    device_type: cisco_nxos
    hosts:
      - 192.168.0.214
      - 192.168.0.215

# =================================================================
# 백업 동작 설정
# =================================================================
backup:
  max_retries: 5          # 장비 접속 최대 재시도 횟수
  retry_delay: 10         # 재시도 대기 시간 (초)
  session_timeout: 30     # Netmiko SSH 세션 타임아웃 (초)
  max_workers: 6          # ThreadPoolExecutor 동시 실행 스레드 수 (v2.3)

# =================================================================
# Config Diff 설정
# =================================================================
diff:
  noise_patterns:
    # --- 공통 (IOS / NX-OS) ---
    - "uptime is"
    - "Last reload"
    - "System image file"

    # --- IOS / IOS-XE ---
    - "Current time"
    - "clock is"
    - "Last input"
    - "Last output"
    - "Last clearing"
    - "output drops"
    - "input errors"
    - "output errors"
    - "5 minute input rate"
    - "5 minute output rate"
    - "packets input"
    - "packets output"
    - "bytes input"
    - "bytes output"

    # --- NX-OS ---
    - "Last Flapped"
    - "30 seconds input rate"
    - "30 seconds output rate"
    - "Load-Interval"

# =================================================================
# 알림 설정 (v3.1 추가)
# 민감 정보는 환경변수 우선 적용:
#   NBT_SLACK_WEBHOOK   : Slack Webhook URL
#   NBT_SMTP_USER       : SMTP 계정 이메일
#   NBT_SMTP_PASSWORD   : SMTP 비밀번호
# =================================================================
notify:
  slack:
    enabled: false
    webhook_url: ""       # 또는 환경변수 NBT_SLACK_WEBHOOK 사용

  email:
    enabled: false
    smtp_host: "smtp.gmail.com"
    smtp_port: 587
    smtp_user: ""         # 또는 환경변수 NBT_SMTP_USER 사용
    smtp_password: ""     # 또는 환경변수 NBT_SMTP_PASSWORD 사용
    from_addr: "nbt-alert@example.com"
    to_addrs:
      - "admin@example.com"

  events:
    on_device_failure: true   # 장비 개별 최종 실패 시 즉시 알림
    on_diff_detected:  true   # Config 변경 감지 시 즉시 알림
    on_summary:        true   # 전체 백업 완료 후 요약 알림